{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AllenDowney/PublicDataToolkit/schema/dataset.schema.json",
  "title": "Dataset",
  "description": "dataset.yaml at the root of a dataset repo: what the dataset is, its terms, its releases, and what its waves, forms and samples are called. Hand-edited. See STANDARD.md \u00a72.",
  "type": "object",
  "properties": {
    "standard_version": {
      "description": "Version of STANDARD.md this repo meets.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "id": {
      "description": "Short dataset id, also the namespace for extensions: gss, anes-cdf, mtf.",
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "url": {
      "description": "The dataset's home page.",
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "description": "Broad subject area, one lowercase word (health, social, labor, education, election, crime), for exports and catalogs that group datasets.",
      "type": "string",
      "pattern": "^[a-z]+$"
    },
    "kind": {
      "description": "survey: answers to questions. administrative: records kept for another purpose (FARS). portal: a table on an open-data portal. Optional; it tunes C6's report, which expects question text only for surveys.",
      "enum": [
        "survey",
        "administrative",
        "portal"
      ]
    },
    "citation": {
      "description": "How the publisher asks to be cited.",
      "type": "string"
    },
    "terms": {
      "description": "Reviewed before anything built from the dataset ships. Per-file terms in sources.yaml must not be looser than these.",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "description": "The relevant terms in a few sentences.",
          "type": "string"
        },
        "data": {
          "$ref": "common.schema.json#/$defs/redistribution"
        },
        "documentation": {
          "$ref": "common.schema.json#/$defs/redistribution"
        },
        "metadata": {
          "description": "Whether the records we build from the documentation may ship. Usually the same as documentation.",
          "$ref": "common.schema.json#/$defs/redistribution"
        },
        "llm_processing": {
          "description": "Whether the documentation's text may be sent to a hosted LLM.",
          "enum": [
            "allowed",
            "not_allowed",
            "unknown"
          ]
        },
        "notice": {
          "description": "Text the terms require to accompany anything that ships, such as a credit line or a disclaimer, verbatim. It goes in the README's terms section and in each data release.",
          "type": "string"
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_on": {
          "$ref": "common.schema.json#/$defs/date"
        }
      },
      "required": [
        "url",
        "summary",
        "data",
        "documentation",
        "metadata",
        "llm_processing"
      ],
      "additionalProperties": false
    },
    "naming": {
      "type": "object",
      "properties": {
        "case": {
          "description": "How the publisher writes variable names. Names are stored as published; lookup in the library is case-insensitive.",
          "enum": [
            "lower",
            "upper",
            "mixed"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "description": "What availability's wave, form, sample, mode, phase and geography mean here. Omit the ones that don't apply.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "wave",
          "form",
          "sample",
          "mode",
          "phase",
          "geography"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "description": "The publisher's word: year, ballot, form, cycle.",
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/wave"
            }
          },
          "column": {
            "description": "The variable in the data that holds this dimension, e.g. year or ballot. Lets availability be checked against the data.",
            "type": "string"
          },
          "codes": {
            "description": "How the column's codes map to the values used in availability, e.g. {\"1\": \"A\", \"2\": \"B\"}. Omit when they're the same.",
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "design": {
      "description": "The survey design variables, by name, so tools can find them: weights, strata and PSU. A release or table can override it. Descriptive only; which weight suits an analysis is the user's choice.",
      "type": "object",
      "properties": {
        "weights": {
          "description": "A name, or {name, waves} for a weight used only in some waves (ATUS TU20FWGT in 2020).",
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "common.schema.json#/$defs/name"},
              {"type": "object", "properties": {"name": {"$ref": "common.schema.json#/$defs/name"}, "waves": {"type": "array", "minItems": 1}, "note": {"type": "string"}}, "required": ["name", "waves"], "additionalProperties": false}
            ]
          },
          "minItems": 1
        },
        "strata": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "psu": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "replicates": {
          "description": "Replicate weights, when variance comes from them: the variables (or a prefix and count) and the method. PISA: 80 weights W_FSTURWT1-80, Fay's method.",
          "type": "object",
          "properties": {
            "variables": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/name"}, "minItems": 1},
            "prefix": {"type": "string"},
            "n": {"type": "integer", "minimum": 1},
            "table": {"description": "The table that holds the replicate weights, when it isn't this one.", "$ref": "common.schema.json#/$defs/id"},
            "key": {"description": "The columns it joins on.", "type": "array", "items": {"$ref": "common.schema.json#/$defs/name"}, "minItems": 1},
            "method": {"enum": ["brr", "fay", "jk1", "jkn", "bootstrap", "sdr", "other"]},
            "fay_factor": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "note": {"type": "string"}
          },
          "required": ["method"],
          "oneOf": [{"required": ["variables"]}, {"required": ["prefix", "n"]}],
          "additionalProperties": false
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "data_rows": {
      "description": "When the common-format data file holds only some rows of each wave (some countries, some states), the column and the codes kept. C3-C5 check only those rows.",
      "type": "object",
      "properties": {
        "column": {"$ref": "common.schema.json#/$defs/name"},
        "in": {"type": "array", "items": {"type": ["string", "integer"]}, "minItems": 1}
      },
      "required": ["column", "in"],
      "additionalProperties": false
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Directory name under metadata/releases/, e.g. 7224r3a or 20260205.",
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "description": "The publisher's name for the release.",
            "type": "string"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "status": {
            "enum": [
              "current",
              "superseded",
              "withdrawn"
            ]
          },
          "sources": {
            "description": "Ids of the files in sources.yaml this release's records were built from.",
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "tables": {
            "description": "When a release has several files, one entry per file. Each table's records are in metadata/releases/<release>/<table>/variables.jsonl.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "sources": {
                  "description": "Ids in sources.yaml for this table's files.",
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  }
                },
                "key": {
                  "description": "Columns that identify a row, e.g. [ST_CASE, VEH_NO].",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "references": {
                  "description": "Columns that refer to another table, as foreign keys, e.g. a vehicle's ST_CASE refers to the crash table.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "columns": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      },
                      "table": {
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "release": {
                        "description": "Omit when the other table is in the same release.",
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "dataset": {
                        "description": "Omit when the other table is in the same dataset, e.g. a code list published separately.",
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "target_columns": {
                        "description": "The other table's columns, when their names differ.",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "when": {
                        "description": "Rows the reference applies to, e.g. {\"column\": \"PER_TYP\", \"in\": [1, 2, 9]}: only occupants of vehicles in transport refer to the vehicle table. A table can list several references from the same columns with different conditions.",
                        "type": "object",
                        "properties": {
                          "column": {
                            "type": "string"
                          },
                          "in": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": [
                                "integer",
                                "number",
                                "string"
                              ]
                            }
                          }
                        },
                        "required": [
                          "column",
                          "in"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "columns",
                      "table"
                    ],
                    "additionalProperties": false
                  }
                },
                "data_waves": {
                  "description": "When the common-format data file holds only some waves (a large or live table built for one year), the waves it holds. C5 checks availability only for these.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "data_rows": {
                  "$ref": "#/properties/data_rows"
                },
                "design": {
                  "$ref": "#/properties/design"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "revisions": {
            "description": "Reissues of this release's files by the publisher, without a new release (STANDARD.md \u00a72.1), e.g. NHTSA's December 2020 revision of the 2017 FARS data.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "$ref": "common.schema.json#/$defs/date"
                },
                "description": {
                  "type": "string"
                },
                "source": {
                  "description": "Id in sources.yaml of the document that describes it, e.g. a release note.",
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "required": [
                "date",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "data_waves": {
            "description": "When the common-format data file holds only some waves (a large or live table built for one year), the waves it holds. C5 checks availability only for these.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "data_rows": {
            "$ref": "#/properties/data_rows"
          },
          "design": {
            "$ref": "#/properties/design"
          },
          "reference_period": {
            "description": "The period the data describe, when it differs from when they were collected (ASEC 2024 asks about income in 2023).",
            "type": "object",
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/date"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/date"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "status",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "data_release": {
      "description": "The GitHub release with the data, when terms.data is ship.",
      "type": "object",
      "properties": {
        "tag": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "tag"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "standard_version",
    "id",
    "title",
    "publisher",
    "url",
    "terms",
    "releases"
  ],
  "additionalProperties": false
}
